# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/
dist-ssr/
.vite/
*.local

# Editors
.vscode/
.idea/
*.swp
.DS_Store

# Env
.env
.env.local
.env.*.local

# Data — anchor to repo root so it only matches the runtime media
# cache, not the agent/flowboard/services/storage/ Python package
# (R2 client lives there).
/storage/
*.db
*.db-journal
*.sqlite
*.sqlite3

# Build
build/
coverage/
.turbo/
**/tsconfig.tsbuildinfo

# OMC ephemeral state (session caches, runtime checkpoints) — plans/ kept
.omc/state/

# Local curl evidence for Veo model dispatch — referenced by flow_sdk.py
# comments as source-of-truth, but contains raw OAuth bearer tokens.
# Keep on disk; never commit.
/video_model*.md
.claude/
docs/samples/raw/

# Google OAuth client + token for the Drive proxy (secrets — never commit)
oauth-client.json
agent/oauth-client.json
drive-token.json
agent/drive-token.json
drive-sa.json
agent/drive-sa.json

# Local secret backups, DB dumps, logs, patches, superseded copies — never commit.
# (.env is already ignored above; .env.full-keys.bak holds REAL keys.)
*.bak
.env.full-keys.bak
*.dump
*.log
logs/
*.patch
frontend/_superseded-*/

# `*.bak` above does not catch a backup named `.env.bak-before-db-switch` — the
# name ends in the suffix, not in `.bak`. Two such files were sitting untracked
# with real Avis / BytePlus / Atrium / R2 / SSO / SMTP credentials in them, so
# the pattern is widened rather than trusted to the extension.
.env.bak*
*.bak-before-*

# Scratch space used while working: logs, screenshots, tokens, rollback copies.
scratchpad/
