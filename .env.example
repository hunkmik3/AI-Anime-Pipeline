# Flowboard — server (multi-user) configuration.
#
# Copy this to ".env" at the repo root and fill the REQUIRED values:
#     cp .env.example .env && nano .env
#
# This template is committed; ".env" itself is gitignored — NEVER commit real keys.

# ── REQUIRED ────────────────────────────────────────────────────────────────
# Shared Avis API key (server-side — powers Seedance video gen for ALL users).
AVIS_API_KEY=

# First admin account — auto-created on first boot while the DB is empty.
FLOWBOARD_ADMIN_USER=admin
FLOWBOARD_ADMIN_PASSWORD=

# Secret that signs login tokens. Generate one:  openssl rand -hex 32
# (deploy.sh fills this automatically if left blank.)
FLOWBOARD_SECRET_KEY=

# ── MULTI-USER (keep as-is) ─────────────────────────────────────────────────
FLOWBOARD_REQUIRE_AUTH=1            # require a login token on every /api call
FLOWBOARD_DISABLE_BRIDGE=1          # no Chrome-extension / Google-Flow bridge
FLOWBOARD_DEFAULT_VIDEO_MODEL=seedance-2-0

# ── B2B UNMODERATED (DanceSee /api/v1/b2b/*) ────────────────────────────────
# Dedicated endpoints that skip BytePlus content moderation. The Avis/DanceSee
# account behind AVIS_API_KEY must be flagged userType=B2B (manual whitelist —
# not self-service). Output is only guaranteed for ~3 hours.
# FLOWBOARD_AVIS_B2B_ENABLED=1
# FLOWBOARD_AVIS_B2B_BASE_URL=https://api.dancesee.io/api/v1

# ── REQUIRED FOR KYC (person-driven video) ──────────────────────────────────
# Person-driven (KYC) gens — and the Dreamina-direct path — need a PUBLIC URL
# for the uploaded assets, so they upload to Cloudflare R2 (S3-compatible).
# NOT needed for normal Avis Seedance video (those send refs inline as base64).
# Without these, clicking KYC fails with "needs public file hosting (R2)".
# Create a bucket + token per docs/r2_setup.md, then fill all four:
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=flowboard-media

# ── GOOGLE WORKSPACE SSO (Phase 2 — optional "Login with Google") ───────────
# Create a Web-application OAuth client in Google Cloud Console (consent screen
# = Internal), add the callback URL below as an Authorized redirect URI, then:
# FLOWBOARD_SSO_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# FLOWBOARD_SSO_GOOGLE_CLIENT_SECRET=
# FLOWBOARD_SSO_ALLOWED_DOMAINS=yourcompany.com     # comma-separated; only these can sign in
# FLOWBOARD_SSO_REDIRECT_URI=https://giantstudio.reelmind.co/api/account/sso/google/callback
# FLOWBOARD_FRONTEND_URL=https://giantstudio.reelmind.co   # only if SPA origin != redirect origin (dev)

# ── SECURITY (Phase 0 hardening — sensible defaults; tune per org) ──────────
# FLOWBOARD_TOKEN_TTL_S=604800        # login token lifetime, seconds (default 7 days)
# FLOWBOARD_LOGIN_MAX_FAILED=5        # wrong-password attempts before lockout
# FLOWBOARD_LOGIN_LOCKOUT_MIN=15      # lockout duration in minutes
# Lock CORS to your public origin (default = localhost dev only; comma-separated):
# FLOWBOARD_CORS_ORIGINS=https://giantstudio.reelmind.co
# Opt-in Content-Security-Policy header (TEST before enabling — a wrong policy
# can break the SPA). Example starting point:
# FLOWBOARD_CSP=default-src 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https:

# ── EMAIL / SMTP (self-service signup approvals) ────────────────────────────
# Needed so an approved signup gets its username + temporary password by email.
# Without these the approval still works — the admin just copies the password
# from the console and sends it by hand.
#
# Google Workspace: use an APP PASSWORD (Google Account → Security → 2-Step
# Verification → App passwords), NOT the account's login password.
# FLOWBOARD_SMTP_HOST=smtp.gmail.com
# FLOWBOARD_SMTP_PORT=587                       # 587 = STARTTLS, 465 = implicit TLS
# FLOWBOARD_SMTP_USER=you@sleepygiant.studio
# FLOWBOARD_SMTP_PASSWORD=xxxxxxxxxxxxxxxx      # 16-char app password
# FLOWBOARD_SMTP_FROM=Giant Studio <you@sleepygiant.studio>
# Public URL put in the email so the new member knows where to sign in:
# FLOWBOARD_APP_URL=https://giantstudio.reelmind.co

# ── OPTIONAL ────────────────────────────────────────────────────────────────
# FLOWBOARD_HTTP_PORT=8101
# FLOWBOARD_DATABASE_URL=postgresql+psycopg://flowboard:flowboard@localhost:15432/flowboard
# FLOWBOARD_STORAGE=/Users/you/flowboard/storage     # where media + cache are kept
